---
import '../styles/tokens.css';
import '../styles/base.css';
import { getSettings, mailto } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const settings = await getSettings();
const pageTitle = title ? `${title} · undulate` : 'undulate · event production & curation';
const metaDescription = description ?? settings.hero.subline ?? '';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const path = Astro.url.pathname;
const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__logo" href="/" aria-label="undulate home">undulate</a>
        <nav aria-label="Main">
          <ul class="site-header__nav">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
            <li>
              <a class="button" href={mailto(settings.email, 'Company event enquiry')} data-track="Email Click" data-track-location="header">
                Get in touch
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>
          <a href={mailto(settings.email)} data-track="Email Click" data-track-location="footer">{settings.email}</a>
          {settings.instagram && <> · <a href={settings.instagram} rel="noopener">Instagram</a></>}
        </p>
        <p class="muted">
          <a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a>
        </p>
      </div>
    </footer>

    <script>
      // Analytics: elements with data-track send a Plausible custom event on click;
      // elements with data-track-view send one the first time they scroll into view.
      // Does nothing when Plausible isn't loaded.
      type Plausible = (name: string, opts?: { props?: Record<string, string> }) => void;
      const send = (name: string, el: HTMLElement) => {
        const p = (window as unknown as { plausible?: Plausible }).plausible;
        const props: Record<string, string> = {};
        if (el.dataset.trackLocation) props.location = el.dataset.trackLocation;
        if (el.dataset.trackLabel) props.label = el.dataset.trackLabel;
        p?.(name, { props });
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (el) send(el.dataset.track!, el);
      });
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          send(el.dataset.trackView!, el);
          io.unobserve(el);
        }
      }, { threshold: 0.4 });
      document.querySelectorAll<HTMLElement>('[data-track-view]').forEach((el) => io.observe(el));
    </script>

    <style>
      .site-header__inner, .site-footer__inner {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: var(--space-3); padding-block: var(--space-3);
      }
      .site-header__logo { font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); text-decoration: none; }
      .site-header__nav { display: flex; align-items: center; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
      .site-header__nav a:not(.button) { text-decoration: none; }
      .site-header__nav a[aria-current='page'] { text-decoration: underline; }
      .site-footer { border-top: 1px solid var(--color-border); margin-top: var(--space-6); font-size: var(--text-sm); }
      .site-footer p { margin: 0; }
    </style>
  </body>
</html>

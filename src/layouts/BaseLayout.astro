---
import '../styles/tokens.css';
import '../styles/base.css';
import '../motion/motion.css';
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-600.css';
import '@fontsource/atkinson-hyperlegible-mono/latin-400.css';
import { getSettings, mailto } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const settings = await getSettings();
const pageTitle = title ? `${title} · undulate` : 'undulate · event production & curation';
const metaDescription = description ?? settings.hero.subline ?? '';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const path = Astro.url.pathname;
const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/basteleur/Basteleur-Moonlight.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <script is:inline>
      // Motion gate: set before render so [data-reveal] content starts hidden instead of flashing.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="head wrap">
      <a class="head__logo" href="/" aria-label="undulate home">undulate</a>
      <nav class="head__nav" aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li><a href={mailto(settings.email, 'Company event enquiry')} data-track="Email Click" data-track-location="header">Get in touch</a></li>
        </ul>
      </nav>
      <button class="head__menu" popovertarget="menu" aria-expanded="false" aria-controls="menu">Menu</button>
      <div id="menu" popover class="menu field">
        <button class="menu__close" popovertarget="menu" popovertargetaction="hide">Close</button>
        <ul>
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
        </ul>
        <a class="button button--ink" href={mailto(settings.email, 'Company event enquiry')} data-track="Email Click" data-track-location="menu">{settings.email}</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot wrap">
      <p class="foot__mark">undulate</p>
      <ul>
        <li><a href={mailto(settings.email)} data-track="Email Click" data-track-location="footer">{settings.email}</a></li>
        {settings.instagram && <li><a href={settings.instagram} rel="noopener">Instagram</a></li>}
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </footer>

    <!-- Motion layer (public/motion/): classic scripts, as Lenis breaks when bundled as a module. -->
    <script is:inline src="/motion/lenis.min.js"></script>
    <script is:inline src="/motion/motion.js"></script>
    <script is:inline>window.UndulateMotion.init();</script>
    <script is:inline>
      // The menu button says whether the menu is open.
      document.getElementById('menu')?.addEventListener('toggle', (e) => document.querySelector('.head__menu')?.setAttribute('aria-expanded', String(e.newState === 'open')));
    </script>

    <script>
      // Analytics: elements with data-track send a Plausible custom event on click;
      // elements with data-track-view send one the first time they scroll into view.
      // Does nothing when Plausible isn't loaded.
      type Plausible = (name: string, opts?: { props?: Record<string, string> }) => void;
      const send = (name: string, el: HTMLElement) => {
        const p = (window as unknown as { plausible?: Plausible }).plausible;
        const props: Record<string, string> = {};
        if (el.dataset.trackLocation) props.location = el.dataset.trackLocation;
        if (el.dataset.trackLabel) props.label = el.dataset.trackLabel;
        p?.(name, { props });
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (el) send(el.dataset.track!, el);
      });
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          send(el.dataset.trackView!, el);
          io.unobserve(el);
        }
      }, { threshold: 0.4 });
      document.querySelectorAll<HTMLElement>('[data-track-view]').forEach((el) => io.observe(el));
    </script>

    <style>
      /* The header floats over whatever field opens the page. */
      .head { position: absolute; inset: 0 0 auto 0; z-index: 5; display: flex; align-items: baseline; justify-content: space-between; padding-top: 2.5rem; }
      @media (min-width: 60rem) { .head { padding-top: 4rem; } }
      .head__logo { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; line-height: 2rem; text-decoration: none; }
      .head__nav { display: none; }
      .head__nav ul { display: flex; gap: var(--space-5); font-weight: 600; }
      .head__nav a { text-decoration: none; }
      .head__nav a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-mark); }
      /* The active page carries the red mark: a short straight bar under the word. */
      .head__nav a[aria-current='page'] { text-decoration: underline solid var(--color-mark); text-decoration-thickness: 2px; text-underline-offset: 0.35em; }
      .head__menu { all: unset; cursor: pointer; padding: 0.625rem 0; margin-block: -0.625rem; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
      .head__menu:focus-visible { outline: 2px solid var(--palette-ink); outline-offset: 3px; }
      @media (min-width: 60rem) { .head__nav { display: block; } .head__menu { display: none; } }
            /* Phone menu: paper with the hero's haze fading down from the top, links large in ink. */
      .menu { inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; border: 0; padding: 2.5rem var(--gutter) var(--space-5); background-color: var(--color-bg); color: var(--color-text); --fade: var(--fade-down); --field: radial-gradient(90% 40% at 0% 0%, rgb(242 160 223 / 0.9), rgb(242 160 223 / 0)), linear-gradient(180deg, #ddd0fc, #c2a8ff); }
      .menu ul a[aria-current='page'] { text-decoration: underline solid var(--color-mark); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
      .menu:popover-open { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; }
      .menu__close { all: unset; cursor: pointer; align-self: flex-end; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
      .menu ul { display: grid; gap: var(--space-3); }
      .menu ul a { font-family: var(--font-display); font-size: 3.5rem; line-height: 1; text-decoration: none; }
      .foot { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3) var(--space-5); padding-block: var(--space-5); border-top: var(--hairline); }
      .foot__mark { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; line-height: 2rem; margin: 0; }
      .foot ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
      .foot a { text-decoration: none; }
      .foot a:hover { text-decoration: underline; text-decoration-color: var(--color-mark); text-decoration-thickness: 2px; }
    </style>
  </body>
</html>

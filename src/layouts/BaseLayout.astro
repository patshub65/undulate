---
import '../styles/tokens.css';
import '../styles/base.css';
import '../motion/motion.css';
import { getSettings, mailto } from '../lib/content';

interface Props { title?: string; description?: string }
const { title, description } = Astro.props;
const settings = await getSettings();
const pageTitle = title ? `${title} · undulate` : 'undulate · event production & curation';
const metaDescription = description ?? settings.hero.subline ?? '';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const path = Astro.url.pathname;
const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/happy-times/happy-times-NG_regular_master_web.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <div class="haze" aria-hidden="true"></div>
    <header class="head wrap">
      <a class="head__logo" href="/" aria-label="undulate home">undulate</a>
      <nav aria-label="Main">
        <ul class="head__nav">
          {nav.map((item) => (
            <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li><a href={mailto(settings.email, 'Company event enquiry')} data-track="Email Click" data-track-location="header">Write</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot wrap">
      <ul class="foot__list mark">
        <li><a href={mailto(settings.email)} data-track="Email Click" data-track-location="footer">{settings.email}</a></li>
        {settings.instagram && <li><a href={settings.instagram} rel="noopener">Instagram</a></li>}
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </footer>

    <script is:inline src="/motion/lenis.min.js"></script>
    <script is:inline src="/motion/motion.js"></script>
    <script is:inline>window.UndulateMotion.init();</script>

    <script>
      type Plausible = (name: string, opts?: { props?: Record<string, string> }) => void;
      const send = (name: string, el: HTMLElement) => {
        const p = (window as unknown as { plausible?: Plausible }).plausible;
        const props: Record<string, string> = {};
        if (el.dataset.trackLocation) props.location = el.dataset.trackLocation;
        if (el.dataset.trackLabel) props.label = el.dataset.trackLabel;
        p?.(name, { props });
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (el) send(el.dataset.track!, el);
      });
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          send(el.dataset.trackView!, el);
          io.unobserve(el);
        }
      }, { threshold: 0.4 });
      document.querySelectorAll<HTMLElement>('[data-track-view]').forEach((el) => io.observe(el));
    </script>

    <style>
      /* The grainy gradient: a full-width haze behind the header that fades into the paper. */
      .haze {
        position: absolute; inset: 0 0 auto 0; height: 26rem; z-index: -1; pointer-events: none;
        background: var(--grain), linear-gradient(100deg, #f24a33 0%, #ff2191 38%, #f2d833 100%);
        background-blend-mode: overlay, normal; opacity: 0.28;
        -webkit-mask-image: linear-gradient(#000 0%, transparent 100%); mask-image: linear-gradient(#000 0%, transparent 100%);
      }
      .head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); padding-top: 2.5rem; padding-bottom: 1.5rem; font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; }
      @media (min-width: 60rem) { .head { padding-top: 4rem; } }
      .head a { text-decoration: none; }
      .head__logo { font-weight: 700; }
      .head__nav { display: flex; gap: var(--space-3); }
      @media (min-width: 60rem) { .head__nav { gap: var(--space-5); } }
      .head__nav a[aria-current='page'] { text-decoration: underline; }
      .head__nav a:hover { background: var(--palette-yellow); }
      .foot { border-top: var(--rule); padding-block: var(--space-4) var(--space-5); }
      .foot__list { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
      .foot__list li:first-child { margin-right: auto; }
      .foot a { text-decoration: none; }
      .foot a:hover { background: var(--palette-yellow); }
    </style>
  </body>
</html>

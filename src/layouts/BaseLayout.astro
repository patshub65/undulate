---
import '../styles/tokens.css';
import '../styles/base.css';
import '../motion/motion.css';
import '@fontsource/familjen-grotesk/latin-400.css';
import '@fontsource/familjen-grotesk/latin-600.css';
import { getSettings, mailto } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const settings = await getSettings();
const pageTitle = title ? `${title} · undulate` : 'undulate · event production & curation';
const metaDescription = description ?? settings.hero.subline ?? '';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const path = Astro.url.pathname;
const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/sporting-grotesque/SportingGrotesque-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <script is:inline>
      // Motion gate: set before render so [data-reveal] content starts hidden instead of flashing.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="head">
      <a class="head__logo" href="/" aria-label="undulate home">undulate</a>
      <nav class="head__nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="head__write" href={mailto(settings.email, 'Company event enquiry')} data-track="Email Click" data-track-location="header">Write</a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <a href={mailto(settings.email)} data-track="Email Click" data-track-location="footer">{settings.email}</a>
      {settings.instagram && <a href={settings.instagram} rel="noopener">Instagram</a>}
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </footer>

    <!-- Motion layer (public/motion/): classic scripts, as Lenis breaks when bundled as a module. -->
    <script is:inline src="/motion/lenis.min.js"></script>
    <script is:inline src="/motion/motion.js"></script>
    <script is:inline>window.UndulateMotion.init();</script>

    <script>
      // Analytics: elements with data-track send a Plausible custom event on click;
      // elements with data-track-view send one the first time they scroll into view.
      // Does nothing when Plausible isn't loaded.
      type Plausible = (name: string, opts?: { props?: Record<string, string> }) => void;
      const send = (name: string, el: HTMLElement) => {
        const p = (window as unknown as { plausible?: Plausible }).plausible;
        const props: Record<string, string> = {};
        if (el.dataset.trackLocation) props.location = el.dataset.trackLocation;
        if (el.dataset.trackLabel) props.label = el.dataset.trackLabel;
        p?.(name, { props });
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (el) send(el.dataset.track!, el);
      });
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          send(el.dataset.trackView!, el);
          io.unobserve(el);
        }
      }, { threshold: 0.4 });
      document.querySelectorAll<HTMLElement>('[data-track-view]').forEach((el) => io.observe(el));
    </script>

    <style>
      /* Header and footer are table rows: every item is a cell. */
      .head, .foot { display: grid; font-family: var(--font-display); font-size: var(--text-xs); line-height: 1.5rem; letter-spacing: 0.06em; text-transform: uppercase; }
      .head a, .foot a { text-decoration: none; transition: background-color 500ms var(--ease-paper), color 500ms var(--ease-paper); }
      .head { grid-template-columns: 1fr auto; }
      .head__logo { font-weight: 700; padding: 2.5rem var(--gutter) 1rem; }
      .head__write { background: var(--palette-yellow); border-left: var(--line); padding: 2.5rem var(--gutter) 1rem var(--pad); grid-row: 1; grid-column: 2; }
      .head__nav { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; border-top: var(--line); }
      .head__nav a { padding: 0.75rem var(--pad); }
      .head__nav a:first-child { padding-left: var(--gutter); }
      .head__nav a + a { border-left: var(--line); }
      .head__nav a[aria-current='page'] { background: var(--palette-ink); color: var(--color-bg); }
      .head__nav a:hover, .head__write:hover, .foot a:hover { background: var(--palette-ink); color: var(--palette-yellow); transition-duration: 120ms; }
      @media (min-width: 60rem) {
        .head { grid-template-columns: 1fr auto auto; }
        .head__logo { padding: 4rem var(--gutter) 1.5rem; }
        .head__nav { grid-column: 2; grid-row: 1; display: flex; border-top: 0; }
        .head__nav a { padding: 4rem var(--pad) 1.5rem; border-left: var(--line); }
        .head__nav a:first-child { padding-left: var(--pad); }
        .head__write { grid-column: 3; padding: 4rem var(--gutter) 1.5rem var(--pad); }
      }
      .foot { border-top: var(--line); }
      .foot a { padding: 0.75rem var(--gutter); }
      .foot a + a { border-top: var(--line); }
      @media (min-width: 60rem) {
        .foot { grid-template-columns: 1fr auto auto auto; }
        .foot a { padding: 1.5rem var(--pad); border-bottom: 0; }
        .foot a:first-child { grid-column: auto; padding-left: var(--gutter); }
        .foot a + a { border-left: var(--line); border-top: 0; }
        .foot a:last-child { padding-right: var(--gutter); }
      }
    </style>
  </body>
</html>

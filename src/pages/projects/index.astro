---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPillars, getProjects, projectsUrl } from '../../lib/content';
const projects = await getProjects();
const pillars = await getPillars();
---
<BaseLayout title="Projects" description="Series, concept events, festivals and company events by undulate.">
  <section class="index">
    <div class="index__head cell cell--l cell--r">
      <p class="label">{projects.length} projects</p>
      <h1>Projects</h1>
    </div>
    <nav class="filters" aria-label="Filter projects">
      <ul class="filters__row">
        <li><a href={projectsUrl()} data-filter="" aria-current="true">All</a></li>
        {pillars.map((pillar) => (
          <li><a href={projectsUrl({ pillar: pillar.id })} data-filter={`pillar:${pillar.id}`}>{pillar.name}</a></li>
        ))}
      </ul>
      {pillars.map((pillar) => (
        <ul class="filters__row filters__row--sub" data-for-pillar={pillar.id}>
          {pillar.specialties.map((s) => (
            <li><a href={projectsUrl({ specialty: s.id })} data-filter={`specialty:${s.id}`}>{s.data.name}</a></li>
          ))}
        </ul>
      ))}
    </nav>
    <div class="index__list" data-project-list>
      {projects.map((p) => <ProjectCard project={p} showSummary />)}
    </div>
    <p class="cell cell--l" data-empty hidden>No projects with this specialty yet.</p>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: without JS every project shows and filter links reload.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-list] > *')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-filter]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  function apply(params: URLSearchParams) {
    const pillar = params.get('pillar');
    const specialty = params.get('specialty');
    let visible = 0;
    for (const card of cards) {
      const match =
        (!pillar || card.dataset.pillars?.split(' ').includes(pillar)) &&
        (!specialty || card.dataset.specialties?.split(' ').includes(specialty));
      card.hidden = !match;
      if (match) visible++;
    }
    const active = pillar ? `pillar:${pillar}` : specialty ? `specialty:${specialty}` : '';
    links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.filter === active)));
    empty.hidden = visible > 0;
  }

  links.forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const url = new URL(a.href);
      history.pushState(null, '', url);
      apply(url.searchParams);
    }),
  );
  addEventListener('popstate', () => apply(new URLSearchParams(location.search)));
  apply(new URLSearchParams(location.search));
</script>
<style>
  .index { border-top: var(--line); }
  .index__head { padding-block: var(--space-5); background: var(--grain), linear-gradient(100deg, var(--color-bg) 0%, var(--color-bg) 30%, #d6c6f3 78%, #c3a6ff 100%); background-blend-mode: soft-light, normal; }
  .index__head h1 { font-size: clamp(2.5rem, 1rem + 7vw, 7rem); line-height: 1; margin-top: var(--space-3); }
  /* Filters are table cells, not pills. */
  .filters__row { display: flex; flex-wrap: wrap; border-top: var(--line); font-family: var(--font-display); font-size: var(--text-xs); line-height: 1.5rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .filters__row li { flex: 1 1 auto; border-right: var(--line); margin-bottom: -1px; border-bottom: var(--line); }
  .filters__row a { display: block; padding: 0.75rem var(--gutter); text-decoration: none; transition: background-color 500ms var(--ease-paper); }
  .filters__row a:hover { background: var(--palette-yellow); transition-duration: 120ms; }
  .filters__row a[aria-current='true'] { background: var(--palette-ink); color: var(--color-bg); }
  .filters__row--sub { text-transform: none; letter-spacing: 0; font-family: var(--font-body); font-size: 1rem; }
  .index__list { margin-top: var(--space-6); border-bottom: var(--line); margin-bottom: var(--space-6); }
  @media (min-width: 60rem) {
    .index__head { padding-block: var(--space-6); }
    .index__head h1 { margin-top: var(--space-5); }
    .filters__row a { padding-inline: var(--pad); }
    .filters__row li:first-child a { padding-left: var(--gutter); }
    .index__list { margin-top: var(--space-7); margin-bottom: var(--space-7); }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPillars, getProjects, projectsUrl } from '../../lib/content';
const projects = await getProjects();
const pillars = await getPillars();
---
<BaseLayout title="Projects" description="Series, concept events, festivals and company events by undulate.">
  <section class="index wrap">
    <div class="row index__head">
      <div class="rail"><p class="mark muted">{projects.length} projects</p></div>
      <h1>Projects</h1>
    </div>
    <nav class="filters row" aria-label="Filter projects">
      <p class="rail mark muted">Filter</p>
      <div>
        <ul class="filters__line mark">
          <li><a href={projectsUrl()} data-filter="" aria-current="true">All</a></li>
          {pillars.map((pillar) => (
            <li><a href={projectsUrl({ pillar: pillar.id })} data-filter={`pillar:${pillar.id}`}>{pillar.name}</a></li>
          ))}
        </ul>
        {pillars.map((pillar) => (
          <ul class="filters__line mark" data-for-pillar={pillar.id}>
            {pillar.specialties.map((s) => (
              <li><a href={projectsUrl({ specialty: s.id })} data-filter={`specialty:${s.id}`}>{s.data.name}</a></li>
            ))}
          </ul>
        ))}
      </div>
    </nav>
    <div class="index__list" data-project-list>
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <p class="muted" data-empty hidden>No projects with this specialty yet.</p>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: without JS every project shows and filter links reload.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-list] > *')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-filter]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  function apply(params: URLSearchParams) {
    const pillar = params.get('pillar');
    const specialty = params.get('specialty');
    let visible = 0;
    for (const card of cards) {
      const match =
        (!pillar || card.dataset.pillars?.split(' ').includes(pillar)) &&
        (!specialty || card.dataset.specialties?.split(' ').includes(specialty));
      card.hidden = !match;
      if (match) visible++;
    }
    const active = pillar ? `pillar:${pillar}` : specialty ? `specialty:${specialty}` : '';
    links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.filter === active)));
    empty.hidden = visible > 0;
  }

  links.forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const url = new URL(a.href);
      history.pushState(null, '', url);
      apply(url.searchParams);
    }),
  );
  addEventListener('popstate', () => apply(new URLSearchParams(location.search)));
  apply(new URLSearchParams(location.search));
</script>
<style>
  .index { padding-bottom: var(--space-7); }
  .index h1 { font-size: clamp(3rem, 2rem + 5vw, 6rem); line-height: 1; letter-spacing: -0.02em; font-style: italic; }
  .index__head { padding-top: var(--space-5); align-items: baseline; }
  .filters { padding-block: var(--space-5); }
  .filters__line { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); }
  .filters__line a { text-decoration: none; }
  .filters__line a:hover { background: var(--palette-yellow); }
  .filters__line a[aria-current='true'] { text-decoration: underline; text-decoration-thickness: 2px; }
  .index__list :global(.pc) { display: grid; gap: var(--space-3); padding-block: var(--space-4); border-top: var(--rule); }
  .index__list :global(.pc:last-child) { border-bottom: var(--rule); }
  .index__list :global(.pc__media) { aspect-ratio: 16 / 10; }
  @media (min-width: 60rem) {
    .index__head { padding-top: var(--space-6); }
    .index__list :global(.pc) { grid-template-columns: var(--rail) minmax(0, 1fr); gap: 0; align-items: start; padding-block: var(--space-5); }
    .index__list :global(.pc__media) { width: 11rem; aspect-ratio: 4 / 5; }
    .index__list :global(.pc__body) { grid-column: 2; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); column-gap: var(--space-6); }
    .index__list :global(.pc__body > .mark:first-child), .index__list :global(.pc h3) { grid-column: 1; }
    .index__list :global(.pc__summary), .index__list :global(.pc__body > ul) { grid-column: 2; }
    .index__list :global(.pc__summary) { grid-row: 1 / span 2; align-self: end; }
  }
</style>

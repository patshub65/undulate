---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPillars, getProjects, projectsUrl } from '../../lib/content';
const projects = await getProjects();
const pillars = await getPillars();
---
<BaseLayout title="Projects" description="Series, concept events, festivals and company events by undulate.">
  <header class="index-head field wrap">
    <h1>Projects</h1>
    <nav class="filters" aria-label="Filter projects">
      <ul class="filters__line filters__line--main">
        <li><a href={projectsUrl()} data-filter="" aria-current="true">All</a></li>
        {pillars.map((pillar) => (
          <li><a href={projectsUrl({ pillar: pillar.id })} data-filter={`pillar:${pillar.id}`}>{pillar.name}</a></li>
        ))}
      </ul>
      {pillars.map((pillar) => (
        <ul class="filters__line" data-for-pillar={pillar.id}>
          {pillar.specialties.map((s) => (
            <li><a href={projectsUrl({ specialty: s.id })} data-filter={`specialty:${s.id}`}>{s.data.name}</a></li>
          ))}
        </ul>
      ))}
    </nav>
  </header>
  <section class="index wrap">
    <div class="index__list mosaic" data-project-list>
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <p class="muted" data-empty hidden>No projects with this specialty yet.</p>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: without JS every project shows and filter links reload.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-list] > *')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-filter]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  function apply(params: URLSearchParams) {
    const pillar = params.get('pillar');
    const specialty = params.get('specialty');
    let visible = 0;
    for (const card of cards) {
      const match =
        (!pillar || card.dataset.pillars?.split(' ').includes(pillar)) &&
        (!specialty || card.dataset.specialties?.split(' ').includes(specialty));
      card.hidden = !match;
      if (match) visible++;
    }
    const active = pillar ? `pillar:${pillar}` : specialty ? `specialty:${specialty}` : '';
    links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.filter === active)));
    empty.hidden = visible > 0;
  }

  links.forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const url = new URL(a.href);
      history.pushState(null, '', url);
      apply(url.searchParams);
    }),
  );
  addEventListener('popstate', () => apply(new URLSearchParams(location.search)));
  apply(new URLSearchParams(location.search));
</script>
<style>
  .index-head { padding-top: 8rem; padding-bottom: 7rem; --fade: var(--fade-down); --field: radial-gradient(70% 90% at 90% 0%, rgb(184 147 255 / 0.9) 0%, rgb(184 147 255 / 0) 100%), radial-gradient(60% 80% at 0% 0%, rgb(242 160 223 / 0.75) 0%, rgb(242 160 223 / 0) 100%), radial-gradient(40% 50% at 55% 100%, rgb(51 245 188 / 0.3) 0%, rgb(51 245 188 / 0) 100%); }
  .index-head h1 { font-size: clamp(3rem, 1.6rem + 8vw, 9rem); line-height: 0.95; letter-spacing: var(--track-xl); margin-bottom: var(--space-5); }
  .filters__line { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); line-height: 2rem; }
  .filters__line--main { font-family: var(--font-label); font-weight: 500; }
  .filters__line a { text-decoration: none; }
  .filters__line a:hover { color: var(--palette-violet); }
  .filters__line a[aria-current='true'] { text-decoration: underline wavy var(--palette-violet); text-decoration-thickness: 2px; text-underline-offset: 0.35em; }
  .index { padding-bottom: var(--space-7); }
  
  @media (min-width: 60rem) {
    .index-head { padding-top: 13rem; }

  }
</style>

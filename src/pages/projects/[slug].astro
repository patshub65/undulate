---
/**
 * Project page. One content type, rendered by template:
 *  - series:     flyer grid first, then write-up and photos
 *  - case-study: photos and write-up first, then any events
 * New templates: add the option in keystatic.config.ts + content.config.ts,
 * then a branch below.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventGrid from '../../components/EventGrid.astro';
import Prose from '../../components/Prose.astro';
import { FORMAT_LABELS, getProjects, getProjectServices, getSettings, mailto, projectsUrl, type Project } from '../../lib/content';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, summary, cover, template, format, client, identity, photos, events } = project.data;
const { specialties, pillars } = await getProjectServices(project);
const { email } = await getSettings();
const hasEvents = events.length > 0;
const hasWriteup = project.body?.trim();
---
<BaseLayout title={title} description={summary}>
  <article class={`project project--${template}`} style={identity.accent ? `--project-accent: ${identity.accent}` : undefined}>
    <header class="section container project__header">
      {identity.logo && <Image class="project__logo" src={identity.logo} alt={`${title} logo`} width={160} />}
      <p class="eyebrow">{FORMAT_LABELS[format]}{client && ` · ${client}`}</p>
      <h1>{title}</h1>
      <p class="project__summary">{summary}</p>
      <ul class="tags" aria-label="Services">
        {pillars.map((p) => <li><a class="tag" href={projectsUrl({ pillar: p.id })}>{p.name}</a></li>)}
        {specialties.map((s) => <li><a class="tag" href={projectsUrl({ specialty: s.id })}>{s.data.name}</a></li>)}
      </ul>
    </header>

    {cover && template === 'case-study' && (
      <div class="container"><Image class="project__cover" src={cover} alt="" widths={[800, 1600]} sizes="100vw" /></div>
    )}

    {template === 'series' && hasEvents && (
      <section class="section container" aria-labelledby="events-heading">
        <h2 id="events-heading">Events</h2>
        <EventGrid project={project} />
      </section>
    )}

    {hasWriteup && <section class="section container"><Prose entry={project} /></section>}

    {photos.length > 0 && (
      <section class="section container" aria-label="Photos">
        <div class="grid project__photos">
          {photos.map((p) => p.image && <Image src={p.image} alt={p.alt ?? ''} widths={[600, 1200]} sizes="(min-width: 60rem) 33vw, 100vw" />)}
        </div>
      </section>
    )}

    {template !== 'series' && hasEvents && (
      <section class="section container" aria-labelledby="events-heading">
        <h2 id="events-heading">Events</h2>
        <EventGrid project={project} />
      </section>
    )}

    <section class="section container project__cta">
      <p>Want something like this for your company?</p>
      <a class="button" href={mailto(email, `Enquiry about ${title}`)} data-track="Email Click" data-track-location="project" data-track-label={title}>Get in touch</a>
    </section>
  </article>
</BaseLayout>
<style>
  .project__header { border-top: 4px solid var(--project-accent, transparent); }
  .project__summary { font-size: var(--text-lg); max-width: 40rem; }
  .project__logo { margin-bottom: var(--space-3); }
  .project__cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-sm); }
  .project__photos img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-sm); }
</style>

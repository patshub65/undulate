---
/**
 * Project page. One content type, rendered by template:
 *  - series:     flyer grid first, then write-up and photos
 *  - case-study: photos and write-up first, then any events
 * New templates: add the option in keystatic.config.ts + content.config.ts,
 * then a branch below.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventGrid from '../../components/EventGrid.astro';
import Prose from '../../components/Prose.astro';
import { FORMAT_LABELS, getProjects, getProjectServices, getSettings, mailto, projectsUrl, type Project } from '../../lib/content';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, summary, cover, template, format, client, identity, photos, events } = project.data;
const { specialties, pillars } = await getProjectServices(project);
const { email } = await getSettings();
const hasEvents = events.length > 0;
const hasWriteup = project.body?.trim();
---
<BaseLayout title={title} description={summary}>
  <article class={`project project--${template}`} style={identity.accent ? `--project-accent: ${identity.accent}` : undefined}>
    <header class="project__header wrap row">
      <div class="rail">
        {identity.logo && <Image class="project__logo" src={identity.logo} alt={`${title} logo`} width={96} />}
        <p class="mark"><span class="project__chip"></span>{FORMAT_LABELS[format]}{client && ` · ${client}`}</p>
      </div>
      <div>
        <h1>{title}</h1>
        <p class="project__summary">{summary}</p>
        <ul class="mark slashes" aria-label="Services">
          {pillars.map((p) => <li><a href={projectsUrl({ pillar: p.id })}>{p.name}</a></li>)}
          {specialties.map((s) => <li><a href={projectsUrl({ specialty: s.id })}>{s.data.name}</a></li>)}
        </ul>
      </div>
    </header>

    {cover && template === 'case-study' && (
      <Image class="project__cover" src={cover} alt="" widths={[800, 1600, 2400]} sizes="100vw" />
    )}

    {template === 'series' && hasEvents && (
      <section class="project__section wrap row" aria-labelledby="events-heading">
        <div class="rail"><h2 id="events-heading" class="mark">Events <span class="muted">{events.length}</span></h2></div>
        <EventGrid project={project} />
      </section>
    )}

    {hasWriteup && <section class="project__section wrap row"><div class="rail"><p class="mark muted">Write-up</p></div><Prose entry={project} /></section>}

    {photos.length > 0 && (
      <section class="project__photos" aria-label="Photos">
        {photos.map((p) => p.image && <Image src={p.image} alt={p.alt ?? ''} widths={[600, 1200, 1800]} sizes="(min-width: 60rem) 60vw, 100vw" data-reveal />)}
      </section>
    )}

    {template !== 'series' && hasEvents && (
      <section class="project__section wrap row" aria-labelledby="events-heading">
        <div class="rail"><h2 id="events-heading" class="mark">Events <span class="muted">{events.length}</span></h2></div>
        <EventGrid project={project} />
      </section>
    )}

    <section class="project__cta wrap row">
      <div class="rail"><p class="mark muted">Write</p></div>
      <div>
        <p class="big">Want something like this for your company?</p>
        <a class="button" href={mailto(email, `Enquiry about ${title}`)} data-track="Email Click" data-track-location="project" data-track-label={title}>Get in touch</a>
      </div>
    </section>
  </article>
</BaseLayout>
<style>
  .project__header { padding-top: var(--space-5); padding-bottom: var(--space-6); }
  .project__header h1 { font-size: clamp(2.5rem, 1rem + 7vw, 7rem); line-height: 1; letter-spacing: -0.02em; margin-bottom: var(--space-4); max-width: 10em; }
  .project--series .project__header h1 { font-style: italic; }
  .project__summary { font-size: 1.25rem; line-height: 2rem; max-width: 36rem; margin-bottom: var(--space-4); }
  .project__header a { text-decoration: none; }
  .project__header a:hover { background: var(--palette-yellow); }
  .project__logo { width: 4rem; height: 4rem; object-fit: cover; margin-bottom: var(--space-3); }
  .project__chip { display: inline-block; width: 0.75rem; height: 0.75rem; margin-right: 0.5rem; background: var(--project-accent, transparent); border: 1px solid var(--palette-ink); vertical-align: -1px; }
  .project__cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .project__section { padding-block: var(--space-5) var(--space-6); border-top: var(--rule); }
  .project__section h2 { font-weight: 400; letter-spacing: 0.04em; }
  .project__cover + .project__section { border-top: 0; padding-top: var(--space-6); }
  .project__photos { display: grid; gap: var(--space-5); padding-bottom: var(--space-6); }
  .project__photos :global(img) { width: 100%; }
  .project__cta { padding-block: var(--space-6); border-top: var(--rule); }
  .project__cta .big { margin-bottom: var(--space-4); }
  @media (min-width: 60rem) {
    .project__header { padding-top: var(--space-6); }
    .project__photos { padding-bottom: var(--space-7); gap: var(--space-6); }
    /* Photos alternate: one hangs off the right edge, the next off the left. */
    .project__photos :global(img:nth-child(odd)) { width: 62%; margin-left: auto; }
    .project__photos :global(img:nth-child(even)) { width: 46%; margin-top: -10rem; }
    .project__cta { padding-block: var(--space-7); }
  }
</style>

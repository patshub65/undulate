---
/**
 * Project page. One content type, rendered by template:
 *  - series:     flyer grid first, then write-up and photos
 *  - case-study: photos and write-up first, then any events
 * New templates: add the option in keystatic.config.ts + content.config.ts,
 * then a branch below.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventGrid from '../../components/EventGrid.astro';
import Prose from '../../components/Prose.astro';
import { FORMAT_LABELS, getProjects, getProjectServices, getSettings, mailto, projectsUrl, type Project } from '../../lib/content';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, summary, cover, template, format, client, identity, photos, events } = project.data;
const { specialties, pillars } = await getProjectServices(project);
const { email } = await getSettings();
const hasEvents = events.length > 0;
const hasWriteup = project.body?.trim();
// The header is a field in the project's own colour: pick ink or white type by the colour's luminance.
const lum = (hex: string) => {
  const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
  if (!m) return 1;
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(m[1].slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
// Ink or white, whichever reads better; a mid-tone accent that carries neither at AA is deepened and takes white.
const ratio = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
const L = identity.accent ? lum(identity.accent) : 1;
const inkOk = ratio(L, 0.01) >= 4.5;
const whiteOk = ratio(L, 1) >= 4.5;
const onAccent = inkOk ? '#191a18' : '#ffffff';
const field = identity.accent && !inkOk && !whiteOk ? `color-mix(in srgb, ${identity.accent} 78%, black)` : identity.accent;
---
<BaseLayout title={title} description={summary}>
  <article class={`project project--${template}`} style={identity.accent ? `--project-accent: ${identity.accent}; --project-field: ${field}; --project-on-accent: ${onAccent}` : undefined}>
    <header class="project__header">
      <div class="container">
        {identity.logo && <Image class="project__logo" src={identity.logo} alt={`${title} logo`} width={160} />}
        <p class="eyebrow">{FORMAT_LABELS[format]}{client && ` · ${client}`}</p>
        <h1>{title}</h1>
        <p class="project__summary">{summary}</p>
      </div>
    </header>

    {cover && template === 'case-study' && (
      <div class="project__cover"><Image src={cover} alt="" widths={[800, 1600, 2400]} sizes="100vw" /></div>
    )}

    {template === 'series' && hasEvents && (
      <section class="section container project__events" aria-labelledby="events-heading">
        <div class="section-head"><h2 id="events-heading">Events</h2></div>
        <EventGrid project={project} />
      </section>
    )}

    <section class="section container project__programme" aria-label="Services">
      {pillars.map((p) => (
        <div class="programme-group">
          <a class="programme-group__category" href={projectsUrl({ pillar: p.id })}>{p.name}</a>
          <ul role="list">
            {specialties.filter((s) => s.data.pillar === p.id).map((s) => <li><a href={projectsUrl({ specialty: s.id })}>{s.data.name}</a></li>)}
          </ul>
        </div>
      ))}
    </section>

    {hasWriteup && <section class="section container project__writeup"><Prose entry={project} /></section>}

    {photos.length > 0 && (
      <section class="section container" aria-label="Photos">
        <div class="project__photos" data-count={photos.length}>
          {photos.map((p) => p.image && <Image src={p.image} alt={p.alt ?? ''} widths={[600, 1200]} sizes="(min-width: 60rem) 50vw, 100vw" data-reveal />)}
        </div>
      </section>
    )}

    {template !== 'series' && hasEvents && (
      <section class="section container project__events" aria-labelledby="events-heading">
        <div class="section-head"><h2 id="events-heading">Events</h2></div>
        <EventGrid project={project} />
      </section>
    )}

    <section class="project__cta">
      <div class="container">
        <p>Want something like this for your company?</p>
        <a class="button" href={mailto(email, `Enquiry about ${title}`)} data-track="Email Click" data-track-location="project" data-track-label={title}>Get in touch</a>
      </div>
    </section>
  </article>
</BaseLayout>

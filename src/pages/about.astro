---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { getSettings, mailto } from '../lib/content';
const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.mdoc');
const { email } = await getSettings();
---
<BaseLayout title={about.data.title ?? 'About'}>
  <section class="about" data-title={about.data.title ?? 'About'}>
    <div class="about__card" data-reveal>
      {about.data.portrait && (
        <Image class="about__portrait" src={about.data.portrait} alt={about.data.portraitAlt ?? ''} widths={[240, 480]} sizes="12rem" />
      )}
      <h1>{about.data.title ?? 'About'}</h1>
      <Prose entry={about} />
      <a class="button" href={mailto(email)} data-track="Email Click" data-track-location="about">Get in touch</a>
    </div>
  </section>
</BaseLayout>

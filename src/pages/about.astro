---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { getSettings, mailto } from '../lib/content';
const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.mdoc');
const { email } = await getSettings();
---
<BaseLayout title={about.data.title ?? 'About'}>
  <section class="section container about">
    {about.data.portrait && <Image src={about.data.portrait} alt={about.data.portraitAlt ?? ''} widths={[400, 800, 1200]} sizes="(min-width: 50rem) 40vw, 100vw" />}
    <div>
      <h1>{about.data.title ?? 'About'}</h1>
      <Prose entry={about} />
      <a class="button" href={mailto(email)} data-track="Email Click" data-track-location="about">Get in touch</a>
    </div>
  </section>
</BaseLayout>
<style>
  .about { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); align-items: start; }
  .about img { border-radius: var(--radius-sm); }
</style>

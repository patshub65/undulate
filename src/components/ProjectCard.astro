---
/** A project as a magazine chapter: a cover square, a heading, its specialties, and two text columns. */
import { Image } from 'astro:assets';
import { FORMAT_LABELS, formatDate, getProjectServices, type Project } from '../lib/content';

interface Props { project: Project }
const { project } = Astro.props;
const { specialties, pillars } = await getProjectServices(project);
const { title, summary, cover, format, client, identity, events } = project.data;
const latest = events.length ? new Date(Math.max(...events.map((e) => e.date.getTime()))) : undefined;
---
<article
  class="chapter"
  data-pillars={pillars.map((p) => p.id).join(' ')}
  data-specialties={specialties.map((s) => s.id).join(' ')}
  style={identity.accent ? `--project-accent: ${identity.accent}` : undefined}
>
  <a href={`/projects/${project.id}/`} class="chapter__cover" tabindex="-1" aria-hidden="true">
    {cover && <Image src={cover} alt="" widths={[400, 800]} sizes="(min-width: 60rem) 20vw, 100vw" />}
  </a>
  <div class="chapter__head">
    <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
    <ul class="chapter__themes" role="list" aria-label="Specialties">
      {specialties.map((s) => <li>{s.data.name}</li>)}
    </ul>
  </div>
  <p class="chapter__summary">{summary}</p>
  <dl class="chapter__facts">
    <div><dt>Format</dt><dd>{FORMAT_LABELS[format]}</dd></div>
    {client && <div><dt>Client</dt><dd>{client}</dd></div>}
    {events.length > 0 && <div><dt>Events</dt><dd>{events.length}</dd></div>}
    {latest && <div><dt>Latest</dt><dd>{formatDate(latest)}</dd></div>}
  </dl>
</article>

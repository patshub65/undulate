---
import { Image } from 'astro:assets';
import { FORMAT_LABELS, getProjectServices, type Project } from '../lib/content';

interface Props { project: Project; showSummary?: boolean }
const { project, showSummary = false } = Astro.props;
const { specialties, pillars } = await getProjectServices(project);
const { title, summary, cover, format, client, identity } = project.data;
---
<article
  class="pc"
  data-pillars={pillars.map((p) => p.id).join(' ')}
  data-specialties={specialties.map((s) => s.id).join(' ')}
  style={identity.accent ? `--project-accent: ${identity.accent}` : undefined}
>
  <div class="pc__main">
    <p class="label">{FORMAT_LABELS[format]}{client && ` · ${client}`}</p>
    <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
    {showSummary && <p class="pc__summary">{summary}</p>}
  </div>
  <p class="pc__roles">{specialties.map((s) => s.data.name).join(', ')}</p>
  <div class="pc__thumb">
    {cover && <Image src={cover} alt="" widths={[300, 600, 900]} sizes="(min-width: 60rem) 18vw, 30vw" />}
  </div>
</article>
<style>
  /* An index row: three cells, and the whole row is the link. */
  .pc { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 6.5rem; border-top: var(--line); transition: background-color 500ms var(--ease-paper), color 500ms var(--ease-paper); }
  .pc:hover { background: var(--palette-ink); color: var(--color-bg); transition-duration: 120ms; }
  .pc__main { padding: var(--space-4) var(--space-3) var(--space-2) var(--gutter); }
  .pc h3 { font-size: var(--d-md); margin-top: var(--space-3); }
  @media (min-width: 60rem) { .pc h3 { margin-top: var(--space-4); } }
  .pc h3 a { text-decoration: none; }
  .pc h3 a::after { content: ''; position: absolute; inset: 0; }
  .pc__summary { margin: var(--space-3) 0 0; max-width: 30rem; }
  .pc__roles { grid-column: 1; margin: 0; padding: 0 var(--space-3) var(--space-4) var(--gutter); font-size: 1rem; }
  .pc__thumb { grid-column: 2; grid-row: 1 / span 2; border-left: var(--line); background: var(--project-accent, var(--palette-sand)); overflow: hidden; }
  .pc__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-paper); }
  .pc:hover .pc__thumb img { transform: scale(1.04); }
  @media (min-width: 60rem) {
    .pc { grid-template-columns: minmax(0, 7fr) minmax(0, 3fr) minmax(0, 2fr); min-height: 11rem; }
    .pc__main { padding: var(--space-5) var(--pad) var(--space-5) var(--gutter); }
    .pc__roles { grid-column: 2; padding: var(--space-5) var(--pad); border-left: var(--line); }
    .pc:hover .pc__roles { border-color: var(--color-bg); }
    .pc__thumb { grid-column: 3; grid-row: 1; }
  }
</style>

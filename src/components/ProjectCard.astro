---
import { Image } from 'astro:assets';
import { FORMAT_LABELS, getProjectServices, type Project } from '../lib/content';

interface Props { project: Project }
const { project } = Astro.props;
const { specialties, pillars } = await getProjectServices(project);
const { title, cover, format, client, identity } = project.data;
---
<article
  class="project-row"
  data-pillars={pillars.map((p) => p.id).join(' ')}
  data-specialties={specialties.map((s) => s.id).join(' ')}
  style={identity.accent ? `--project-accent: ${identity.accent}` : undefined}
  data-reveal
>
  <a href={`/projects/${project.id}/`} class="project-row__link">
    <span class="project-row__title">
      <h3>{title}</h3>
      <span class="project-row__format">{FORMAT_LABELS[format]}{client && ` · ${client}`}</span>
    </span>
    <span class="project-row__media">
      {cover && <Image src={cover} alt="" widths={[400, 800, 1200]} sizes="(min-width: 60rem) 25vw, 100vw" />}
    </span>
  </a>
  <ul class="project-row__roles" role="list" aria-label="Specialties">
    {specialties.map((s) => <li>{s.data.name}</li>)}
  </ul>
</article>

---
import { getCompanyFormats, getSettings, mailto } from '../../lib/content';
const formats = await getCompanyFormats();
const { email, companies } = await getSettings();
---
<section class="companies wrap" id="companies" aria-labelledby="companies-heading" data-track-view="Companies Section View">
  <div class="companies__stay">
    <h2 id="companies-heading">{companies.heading}</h2>
    {companies.intro && <p class="companies__intro">{companies.intro}</p>}
    <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="companies">{companies.cta}</a>
  </div>
  <ul class="companies__list">
    {formats.map((f) => (
      <li data-reveal>
        <h3>{f.data.name}</h3>
        {f.data.description && <p>{f.data.description}</p>}
      </li>
    ))}
  </ul>
</section>
<style>
  .companies { padding-block: var(--space-6); display: grid; gap: var(--space-6); }
  .companies h2 { font-size: 2rem; line-height: 2.5rem; margin-bottom: var(--space-2); }
  .companies__intro { max-width: 22rem; margin-bottom: var(--space-4); }
  .companies__list { display: grid; border-bottom: var(--hairline); }
  /* Each format opens on a hairline; the stepped indents stay, the line runs the full column. */
  .companies__list li { border-top: var(--hairline); padding-block: var(--space-4) var(--space-5); }
  .companies__list h3 { font-size: var(--d-lg); line-height: 1.04; letter-spacing: var(--track-xl); transition: color 500ms var(--ease-paper); }
  .companies__list li:hover h3 { color: var(--palette-violet); transition-duration: 120ms; }
  .companies__list p { margin: var(--space-2) 0 0; max-width: 24rem; color: var(--color-text-muted); }
  .companies__list li:nth-child(even) { padding-left: var(--space-5); }
  .companies__list li:hover { border-top-color: var(--color-mark); transition: border-color 120ms; }
  @media (min-width: 60rem) {
    .companies { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-6); padding-block: var(--space-7); align-items: start; }
    /* The offer stays put; the formats scroll past it. */
    .companies__stay { position: sticky; top: 38vh; }
    .companies__list { margin-bottom: var(--space-5); }
    .companies__list li { padding-block: var(--space-5) var(--space-6); }
    .companies__list li:nth-child(even) { padding-left: 18%; }
    .companies__list li:nth-child(3n) { padding-left: 8%; }
  }
</style>

---
import { getCompanyFormats, getSettings, mailto } from '../../lib/content';
const formats = await getCompanyFormats();
const { email, companies } = await getSettings();
---
<section class="section companies" id="companies" aria-labelledby="companies-heading" data-track-view="Companies Section View">
  <div class="container">
    <h2 id="companies-heading">{companies.heading}</h2>
    {companies.intro && <p class="companies__intro">{companies.intro}</p>}
    <ul class="grid companies__formats" role="list">
      {formats.map((f) => (
        <li>
          <h3>{f.data.name}</h3>
          {f.data.description && <p class="muted">{f.data.description}</p>}
        </li>
      ))}
    </ul>
    <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="companies">{companies.cta}</a>
  </div>
</section>
<style>
  .companies { background: var(--color-surface); }
  .companies__intro { font-size: var(--text-lg); max-width: 38rem; }
  .companies__formats { list-style: none; padding: 0; margin-block: var(--space-5); }
</style>

---
import { Image } from 'astro:assets';
import { getSettings, mailto } from '../../lib/content';
const { email, hero } = await getSettings();
---
<section class="hero">
  {hero.image && (
    <Image class="hero__image" src={hero.image} alt={hero.imageAlt ?? ''} widths={[800, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
  )}
  <div class="container hero__content">
    <h1>{hero.headline}</h1>
    {hero.subline && <p class="hero__subline">{hero.subline}</p>}
    <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="hero">{hero.cta}</a>
  </div>
</section>
<style>
  .hero { position: relative; display: grid; min-height: min(85vh, 50rem); align-items: end; color: #fff; overflow: hidden; }
  .hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 30%, rgb(0 0 0 / 0.65)); }
  .hero__content { position: relative; z-index: 1; padding-block: var(--space-6); }
  .hero__subline { font-size: var(--text-lg); max-width: 38rem; }
</style>

---
import { Image } from 'astro:assets';
import { getPillars, getSettings, mailto } from '../../lib/content';
const { email, hero } = await getSettings();
const pillars = await getPillars();
---
<section class="hero">
  <div class="hero__headline cell cell--l cell--r">
    <h1>{hero.headline}</h1>
  </div>
  {hero.subline && <div class="hero__subline cell"><p>{hero.subline}</p></div>}
  <a class="hero__cta fill cell cell--r" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="hero">
    <span class="label">{email}</span>
    <span class="fill__word">{hero.cta}</span>
  </a>
  {hero.image && (
    <div class="hero__photo">
      <Image src={hero.image} alt={hero.imageAlt ?? ''} widths={[700, 1200, 1800]} sizes="(min-width: 60rem) 42vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
  )}
  <ul class="hero__index cell cell--r">
    {pillars.map((p) => (
      <li><a href="#services"><span class="label">{p.specialties.length} specialties</span><span class="hero__pillar">{p.name}</span></a></li>
    ))}
  </ul>
</section>
<style>
  .hero { display: grid; border-top: var(--line); border-bottom: var(--line); }
  .hero > * + * { border-top: var(--line); }
  /* The grainy gradient: one full-width strip, sand running into lilac, behind the headline. */
  .hero__headline { background: var(--grain), linear-gradient(100deg, var(--color-bg) 0%, var(--color-bg) 30%, #d6c6f3 78%, #c3a6ff 100%); background-blend-mode: soft-light, normal; }
  .hero h1 { font-size: var(--d-lg); max-width: 17em; }
  .hero__subline p { font-size: 1.125rem; line-height: 1.5rem; margin: 0; max-width: 30rem; }
  .hero__cta { min-height: 6.5rem; }
  .hero__photo img { width: 100%; height: 14rem; object-fit: cover; }
  .hero__index { display: none; }
  @media (min-width: 60rem) {
    .hero { grid-template-columns: 5fr 4fr 3fr; grid-template-rows: auto auto 1fr; }
    .hero > * + * { border-top: 0; }
    .hero__headline { grid-column: 1 / -1; padding-block: var(--space-6); border-bottom: var(--line); }
    .hero__photo { grid-column: 1; grid-row: 2 / span 2; }
    .hero__photo img { height: 100%; min-height: 26rem; }
    .hero__subline { grid-column: 2; grid-row: 2 / span 2; border-left: var(--line); }
    .hero__subline p { font-size: 1.5rem; line-height: 2rem; }
    .hero__cta { grid-column: 3; grid-row: 2; border-left: var(--line); min-height: 13rem; }
    .hero__index { display: block; grid-column: 3; grid-row: 3; border-left: var(--line); border-top: var(--line); }
    .hero__index li + li { margin-top: var(--space-3); }
    .hero__index a { display: grid; text-decoration: none; }
    .hero__pillar { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; line-height: 1.5rem; }
    .hero__index a:hover .hero__pillar { text-decoration: underline; text-decoration-thickness: 2px; }
  }
</style>

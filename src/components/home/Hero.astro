---
import { Image } from 'astro:assets';
import { getSettings, mailto } from '../../lib/content';
const { email, hero } = await getSettings();
---
<section class="hero">
  <div class="hero__field field wrap">
    <div class={`hero__text${hero.image ? ' has-photo' : ''}`}>
      <h1>{hero.headline}</h1>
      {hero.image && (
        <div class="hero__photo">
          <Image src={hero.image} alt={hero.imageAlt ?? ''} widths={[500, 900, 1400]} sizes="(min-width: 60rem) 45vw, 62vw" loading="eager" fetchpriority="high" />
          {/* The headline runs on over the photo: a white copy, clipped to the photo, set exactly over the ink one. */}
          <span class="hero__over" aria-hidden="true" data-text={hero.headline}></span>
        </div>
      )}
      <div class="hero__rest">
        {hero.subline && <p class="hero__subline">{hero.subline}</p>}
        <a class="button button--ink" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="hero">{hero.cta}</a>
      </div>
    </div>
  </div>
</section>
<style>
  /* Text overlapping the hero image (from the reference). The photo sits in flow under the headline and is pulled up
     by --over, so its top runs behind the headline's last lines. The headline's white copy lives inside the photo,
     clipped by it, its bottom aligned to the ink headline's bottom: same width (100cqw), same type, same breaks. */
  .hero__field {
    padding-top: 7.5rem; padding-bottom: 8rem;
    --fade: var(--fade-down);
    --field:
      radial-gradient(80% 40% at 0% 0%, rgb(242 160 223 / 0.85) 0%, rgb(242 160 223 / 0) 100%),
      radial-gradient(60% 40% at 100% 20%, rgb(184 147 255 / 0.9) 0%, rgb(184 147 255 / 0) 100%),
      radial-gradient(60% 30% at 0% 100%, rgb(51 245 188 / 0.35) 0%, rgb(51 245 188 / 0) 100%);
  }
  .hero__text { --over: 4.5rem; container-type: inline-size; display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero h1, .hero__over::before {
    font-family: var(--font-display); font-weight: 400; font-size: clamp(2.125rem, 1rem + 4.8vw, 5.25rem);
    line-height: 1; letter-spacing: var(--track-xl); text-wrap: balance;
  }
  .hero h1 { margin: 0; }
  .hero__photo { position: relative; z-index: 1; overflow: hidden; width: 64%; justify-self: end; margin-top: calc(-1 * var(--over)); }
  .hero__photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  /* Ink under the copy only, so the white reads on any photo: 60% ink keeps it above 4.5:1 even on white. */
  .hero__photo::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgb(25 26 24 / 0.6) 0, rgb(25 26 24 / 0.6) calc(var(--over) + 0.5rem), rgb(25 26 24 / 0) calc(var(--over) + 6rem));
  }
  .hero__over::before {
    content: attr(data-text); position: absolute; z-index: 1; color: #fff;
    width: 100cqw; left: calc(100% - 100cqw); bottom: calc(100% - var(--over));
  }
  .hero__rest { padding-top: var(--space-4); }
  .hero__subline { font-size: 1.125rem; line-height: 1.75rem; max-width: 30rem; margin-bottom: var(--space-4); }
  @media (min-width: 60rem) {
    .hero__field { padding-top: 12rem; padding-bottom: 10rem; }
    .hero__text { --over: 7rem; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr); }
    .hero h1 { grid-column: 1 / -1; }
    .hero__photo { grid-column: 2; grid-row: 2; width: 100%; }
    .hero__photo img { aspect-ratio: 5 / 4; }
    .hero__rest { grid-column: 1; grid-row: 2; padding-right: var(--space-6); padding-top: var(--space-5); }
    .hero__subline { font-size: 1.375rem; line-height: 2rem; max-width: 34rem; margin-bottom: var(--space-5); }
  }
</style>

---
import { Image } from 'astro:assets';
import { getSettings, mailto } from '../../lib/content';
const { email, hero } = await getSettings();
---
<section class="hero">
  <div class="hero__media" aria-hidden={hero.image ? undefined : 'true'}>
    {hero.image && (
      <Image class="hero__image" src={hero.image} alt={hero.imageAlt ?? ''} widths={[800, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" data-parallax data-parallax-range="32" />
    )}
  </div>
  <div class="container hero__content">
    <h1 data-reveal>{hero.headline}</h1>
    <div class="hero__foot" data-reveal>
      {hero.subline && <p class="hero__subline">{hero.subline}</p>}
      <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="hero">{hero.cta}</a>
    </div>
  </div>
</section>

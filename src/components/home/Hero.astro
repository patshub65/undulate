---
import { Image } from 'astro:assets';
import { getCompanyFormats, getProjects, getSettings, mailto } from '../../lib/content';
const { email, hero } = await getSettings();
// The roster: company event formats and the projects, interleaved, as names on the gradient field.
const formats = (await getCompanyFormats()).map((f) => ({ name: f.data.name, href: '#companies' }));
const projects = (await getProjects()).map((p) => ({ name: p.data.title, href: `/projects/${p.id}/` }));
const roster = [];
for (let i = 0; i < Math.max(formats.length, projects.length); i++) {
  if (formats[i]) roster.push(formats[i]);
  if (projects[i]) roster.push(projects[i]);
}
---
<section class="hero">
  {hero.image && (
    <div class="hero__media">
      <Image class="hero__image" src={hero.image} alt={hero.imageAlt ?? ''} widths={[800, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
  )}
  <div class="container hero__content">
    <h1 data-reveal>{hero.headline}</h1>
    <div class="hero__foot">
      {hero.subline && <p class="hero__subline">{hero.subline}</p>}
      <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="hero">{hero.cta}</a>
    </div>
  </div>
  <nav class="container roster" aria-label="Formats and projects">
    <ul role="list">
      {roster.map((r) => <li><a href={r.href}>{r.name}</a></li>)}
    </ul>
  </nav>
</section>

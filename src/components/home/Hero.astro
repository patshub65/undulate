---
import { Image } from 'astro:assets';
import { formatDate, getCompanyFormats, getSettings, getSpecialties, getUpcomingEvents, mailto } from '../../lib/content';
const { email, hero } = await getSettings();
const formats = await getCompanyFormats();
const specialties = await getSpecialties();
const [next] = await getUpcomingEvents(1);
---
<section class="hero wrap">
  <div class="hero__text">
    <h1>{hero.headline}</h1>
    {hero.subline && <p class="hero__subline">{hero.subline}</p>}
    <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="hero">{hero.cta}</a>
    <dl class="hero__facts mark">
      <div><dt>For companies</dt><dd>{formats.length} formats</dd></div>
      <div><dt>In house</dt><dd>{specialties.length} specialties</dd></div>
      {next && <div><dt>Next night</dt><dd>{formatDate(next.date)}</dd></div>}
    </dl>
  </div>
  {hero.image && (
    <div class="hero__photo" data-parallax data-parallax-range="24">
      <Image src={hero.image} alt={hero.imageAlt ?? ''} widths={[600, 1000, 1600]} sizes="(min-width: 60rem) 36vw, 90vw" loading="eager" fetchpriority="high" />
    </div>
  )}
</section>
<style>
  .hero { display: grid; padding-top: var(--space-3); border-bottom: var(--rule); }
  .hero h1 { font-size: clamp(2.125rem, 1rem + 4.6vw, 5rem); line-height: 1.06; letter-spacing: -0.02em; max-width: 13em; margin-bottom: var(--space-4); }
  .hero__subline { font-size: 1.125rem; line-height: 1.5rem; max-width: 28rem; margin-bottom: var(--space-4); }
  .hero__facts { display: none; }
  .hero__photo { margin: var(--space-5) calc(-1 * var(--gutter)) -3rem var(--space-6); position: relative; z-index: 1; }
  .hero__photo img { width: 100%; height: 15rem; object-fit: cover; }
  @media (min-width: 60rem) {
    .hero { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); column-gap: var(--space-6); padding-top: var(--space-6); }
    .hero__text { padding-bottom: var(--space-6); }
    .hero__subline { font-size: 1.5rem; line-height: 2rem; max-width: 34rem; margin-bottom: var(--space-5); }
    .hero__facts { display: grid; grid-template-columns: repeat(3, max-content); gap: var(--space-6); margin: var(--space-6) 0 0; }
    .hero__facts dt { color: var(--color-text-muted); }
    .hero__facts dd { margin: 0; }
    .hero__photo { margin: -5rem calc(-1 * var(--gutter)) -6rem 0; }
    .hero__photo img { height: 100%; min-height: 40rem; }
  }
</style>

---
import { Image } from 'astro:assets';
import { getSettings, mailto } from '../../lib/content';
const { email, hero } = await getSettings();
---
<section class="hero">
  {hero.image && (
    <div class="hero__media">
      <Image class="hero__image" src={hero.image} alt={hero.imageAlt ?? ''} widths={[800, 1600, 2400]} sizes="(min-width: 60rem) 58vw, 100vw" loading="eager" fetchpriority="high" data-parallax data-parallax-range="24" />
    </div>
  )}
  <div class="hero__content">
    <h1 data-reveal>{hero.headline}</h1>
    <div class="hero__foot">
      {hero.subline && <p class="hero__subline">{hero.subline}</p>}
      <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="hero">{hero.cta}</a>
    </div>
  </div>
</section>

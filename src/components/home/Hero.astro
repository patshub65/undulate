---
import { Image } from 'astro:assets';
import { getSettings, mailto } from '../../lib/content';
const { email, hero } = await getSettings();
// The headline mixes two faces per word: small joining words stay in the light sans,
// the words that carry the meaning are set in the bold serif. Works on whatever Jasmin writes.
const joiners = new Set(['a', 'an', 'and', 'the', 'for', 'that', 'than', 'of', 'to', 'in', 'on', 'at', 'with', 'by', 'or', 'as', 'is', 'are', 'it', 'its', 'we', 'our', 'your', 'you', 'want', 'who', 'from', 'not', 'but']);
const words = hero.headline.split(/\s+/).map((w) => ({ w, light: joiners.has(w.toLowerCase().replace(/[^\p{L}]/gu, '')) }));
---
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <h1 data-reveal>
        {words.map(({ w, light }, i) => <>{i > 0 && ' '}{light ? w : <span class="hero__bold">{w}</span>}</>)}
      </h1>
      <div class="hero__foot" data-reveal>
        {hero.subline && <p class="hero__subline">{hero.subline}</p>}
        <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="hero">{hero.cta}</a>
      </div>
    </div>
  </div>
  {hero.image && (
    <div class="hero__media">
      <Image class="hero__image" src={hero.image} alt={hero.imageAlt ?? ''} widths={[800, 1600, 2400]} sizes="(min-width: 60rem) 45vw, 100vw" loading="eager" fetchpriority="high" data-parallax data-parallax-range="24" />
    </div>
  )}
</section>

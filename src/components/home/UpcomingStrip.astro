---
/**
 * Next events across all projects. Built at deploy time; a small script also
 * hides events whose date has passed, in case the site hasn't been rebuilt.
 */
import EventCard from '../EventCard.astro';
import { getSettings, getUpcomingEvents } from '../../lib/content';
const { upcomingCount } = await getSettings();
// Render a few extra so the strip stays full after client-side hiding.
const limit = upcomingCount ?? 4;
const events = await getUpcomingEvents(limit + 4);
---
{events.length > 0 && (
  <section class="upcoming" aria-labelledby="upcoming-heading" data-upcoming data-limit={limit}>
    <div class="upcoming__head cell cell--l">
      <h2 id="upcoming-heading">Coming up</h2>
    </div>
    <ul class="upcoming__wall">
      {events.map((event, i) => (
        <li><EventCard event={event} id={`upcoming-${i}`} showProject upcomingOnly /></li>
      ))}
    </ul>
  </section>
)}
<script>
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('[data-upcoming]').forEach((section) => {
    const limit = Number(section.dataset.limit);
    let shown = 0;
    section.querySelectorAll<HTMLElement>('[data-event-date]').forEach((card) => {
      const keep = card.dataset.eventDate! >= today && shown < limit;
      (card.closest('li') ?? card).hidden = !keep;
      if (keep) shown++;
    });
    section.hidden = shown === 0;
  });
</script>
<style>
  .upcoming { display: grid; margin-top: var(--space-6); border-top: var(--line); border-bottom: var(--line); }
  .upcoming h2 { font-size: var(--d-md); }
  .upcoming__wall { display: grid; }
  .upcoming__wall li { border-top: var(--line); }
  @media (min-width: 60rem) {
    .upcoming { grid-template-columns: 1fr 3fr; margin-top: var(--space-7); margin-left: 0; }
    .upcoming__head { padding-block: var(--space-5); }
    .upcoming__wall { grid-template-columns: repeat(3, 1fr); }
    .upcoming__wall li { border-top: 0; border-left: var(--line); }
    .upcoming__wall li:nth-child(n + 4 of :not([hidden])) { border-top: var(--line); }
    .upcoming__wall li:last-child { border-right: var(--line); }
  }
</style>

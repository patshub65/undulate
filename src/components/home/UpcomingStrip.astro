---
import EventCard from '../EventCard.astro';
import { getSettings, getUpcomingEvents } from '../../lib/content';
const { upcomingCount } = await getSettings();
const limit = upcomingCount ?? 4;
const events = await getUpcomingEvents(limit + 4);
---
{events.length > 0 && (
  <section class="upcoming wrap" aria-labelledby="upcoming-heading" data-upcoming data-limit={limit}>
    <h2 id="upcoming-heading" class="mark">Coming up</h2>
    <ul class="upcoming__list">
      {events.map((event, i) => (
        <li><EventCard event={event} id={`upcoming-${i}`} showProject upcomingOnly layout="row" /></li>
      ))}
    </ul>
  </section>
)}
<script>
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('[data-upcoming]').forEach((section) => {
    const limit = Number(section.dataset.limit);
    let shown = 0;
    section.querySelectorAll<HTMLElement>('[data-event-date]').forEach((card) => {
      const keep = card.dataset.eventDate! >= today && shown < limit;
      (card.closest('li') ?? card).hidden = !keep;
      if (keep) shown++;
    });
    section.hidden = shown === 0;
  });
</script>
<style>
  .upcoming { padding-bottom: var(--space-6); }
  .upcoming h2 { font-weight: 400; letter-spacing: 0.04em; padding-bottom: var(--space-2); }
  .upcoming__list { border-bottom: var(--rule); }
  @media (min-width: 60rem) { .upcoming { padding-bottom: var(--space-7); } }
</style>

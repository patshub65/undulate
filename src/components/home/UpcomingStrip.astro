---
/**
 * Next events across all projects. Built at deploy time; a small script also
 * hides events whose date has passed, in case the site hasn't been rebuilt.
 */
import EventCard from '../EventCard.astro';
import { getSettings, getUpcomingEvents } from '../../lib/content';
const { upcomingCount } = await getSettings();
// Render a few extra so the strip stays full after client-side hiding.
const limit = upcomingCount ?? 4;
const events = await getUpcomingEvents(limit + 4);
---
{events.length > 0 && (
  <section class="upcoming field wrap" aria-labelledby="upcoming-heading" data-upcoming data-limit={limit}>
    <h2 id="upcoming-heading" class="kicker">Coming up</h2>
    <ul class="upcoming__list">
      {events.map((event, i) => (
        <li><EventCard event={event} id={`upcoming-${i}`} showProject upcomingOnly /></li>
      ))}
    </ul>
  </section>
)}
<script>
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('[data-upcoming]').forEach((section) => {
    const limit = Number(section.dataset.limit);
    let shown = 0;
    section.querySelectorAll<HTMLElement>('[data-event-date]').forEach((card) => {
      const keep = card.dataset.eventDate! >= today && shown < limit;
      (card.closest('li') ?? card).hidden = !keep;
      if (keep) shown++;
    });
    section.hidden = shown === 0;
  });
</script>
<style>
  /* A faint yellow field behind the next flyer, fading out. */
  .upcoming {
    padding-block: var(--space-6);
    --field: radial-gradient(min(40rem, 90vw) 50% at 30% 50%, rgb(242 216 51 / 0.38), rgb(242 216 51 / 0) 100%);
    --fade: radial-gradient(min(40rem, 90vw) 50% at 30% 50%, #000, transparent 100%);
  }
  .upcoming h2 { margin-bottom: var(--space-4); }
  .upcoming__list { display: grid; gap: var(--space-4); }
  /* The next event is the feature: its flyer large, its name in the display face. */
  .upcoming__list li:nth-child(1 of :not([hidden])) :global(.ev__flyer) { width: 78%; }
  .upcoming__list li:nth-child(1 of :not([hidden])) :global(.ev__name) { font-size: var(--d-lg); line-height: 1.04; letter-spacing: var(--track-xl); margin-block: var(--space-2); }
  /* The rest are a short list with a small flyer. */
  .upcoming__list li:not(:nth-child(1 of :not([hidden]))) :global(.ev__trigger) { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: var(--space-3); align-items: center; }
  .upcoming__list li:not(:nth-child(1 of :not([hidden]))) :global(.ev__meta) { padding-top: 0; }
  @media (min-width: 60rem) {
    .upcoming { padding-block: var(--space-7); }
    .upcoming__list { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); column-gap: var(--space-6); align-items: start; margin-left: 12%; }
    .upcoming__list li:nth-child(1 of :not([hidden])) { grid-row: 1 / span 8; }
    .upcoming__list li:nth-child(1 of :not([hidden])) :global(.ev__trigger) { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-5); align-items: end; }
    .upcoming__list li:nth-child(1 of :not([hidden])) :global(.ev__flyer) { width: 100%; }
    .upcoming__list li:not(:nth-child(1 of :not([hidden]))) { grid-column: 2; }
  }
</style>

---
import ProjectCard from '../ProjectCard.astro';
import { getFeaturedProjects } from '../../lib/content';
const projects = await getFeaturedProjects();
---
{projects.length > 0 && (
  <section class="featured wrap" aria-labelledby="featured-heading">
    <div class="featured__head">
      <h2 id="featured-heading" class="kicker">Selected projects</h2>
      <a class="more" href="/projects/">All projects</a>
    </div>
    <div class="mosaic">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
)}
<style>
  .featured { padding-block: var(--space-6); }
  .featured__head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-5); }
  .featured :global(.pc__summary) { display: none; }
  @media (min-width: 60rem) {
    .featured { padding-block: var(--space-7); }
    .featured :global(.pc__summary) { display: block; }
  }
</style>

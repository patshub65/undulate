---
import { getSettings, mailto } from '../../lib/content';
const { email, closing } = await getSettings();
---
<section class="section container closing">
  {closing.heading && <h2 data-reveal>{closing.heading}</h2>}
  <div class="closing__foot" data-reveal>
    {closing.text && <p>{closing.text}</p>}
    <a class="button" href={mailto(email, 'Company event enquiry')} data-track="Email Click" data-track-location="closing">{email}</a>
  </div>
</section>

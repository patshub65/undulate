---
import { Image } from 'astro:assets';
import { getAbout, getSettings } from '../../lib/content';
const { aboutTeaser } = await getSettings();
const about = await getAbout();
---
<section class:list={['teaser', !about.portrait && 'teaser--bare']} aria-labelledby="about-heading">
  {about.portrait && <Image class="teaser__photo" src={about.portrait} alt={about.portraitAlt ?? ''} widths={[600, 1200, 1800]} sizes="100vw" />}
  <div class="teaser__block cell cell--r">
    <h2 id="about-heading" class="label">About undulate</h2>
    {aboutTeaser && <p>{aboutTeaser}</p>}
    <a class="button" href="/about/">More about Jasmin</a>
  </div>
</section>
<style>
  /* A full-bleed portrait; the words sit in a solid block in its corner. */
  .teaser { position: relative; margin-top: var(--space-6); border-top: var(--line); }
  .teaser__photo { width: 100%; height: 20rem; object-fit: cover; object-position: 50% 25%; }
  .teaser__block { background: var(--color-bg); border-top: var(--line); }
  .teaser h2 { font-weight: 700; }
  .teaser p:not(.label) { font-size: 1.25rem; line-height: 2rem; margin: var(--space-3) 0 var(--space-4); }
  @media (min-width: 60rem) {
    .teaser { margin-top: var(--space-7); }
    .teaser__photo { height: 44rem; }
    .teaser__block { position: absolute; right: 0; bottom: 0; width: 42%; border-left: var(--line); padding-block: var(--space-5); }
    .teaser--bare .teaser__block { position: static; margin-left: auto; }
  }
</style>

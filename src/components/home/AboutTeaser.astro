---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getSettings } from '../../lib/content';
const { aboutTeaser } = await getSettings();
const about = await getEntry('pages', 'about');
---
<section class="section container about-teaser" aria-labelledby="about-heading">
  {about?.data.portrait && (
    <div class="about-teaser__media" data-reveal>
      <Image src={about.data.portrait} alt={about.data.portraitAlt ?? ''} widths={[400, 800]} sizes="(min-width: 60rem) 30vw, 100vw" />
    </div>
  )}
  <div class="about-teaser__text" data-reveal>
    <h2 id="about-heading" class="label">About undulate</h2>
    {aboutTeaser && <p class="about-teaser__lede">{aboutTeaser}</p>}
    <a class="text-link" href="/about/">More about Jasmin →</a>
  </div>
</section>

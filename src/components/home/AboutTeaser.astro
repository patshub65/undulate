---
import { Image } from 'astro:assets';

import { getAbout, getSettings } from '../../lib/content';
const { aboutTeaser } = await getSettings();
const about = await getAbout();
---
<section class="section container about-teaser" aria-labelledby="about-heading">
  {about.portrait && <Image src={about.portrait} alt={about.portraitAlt ?? ''} widths={[400, 800]} sizes="(min-width: 50rem) 30vw, 100vw" />}
  <div>
    <h2 id="about-heading">About undulate</h2>
    {aboutTeaser && <p>{aboutTeaser}</p>}
    <a href="/about/">More about Jasmin →</a>
  </div>
</section>
<style>
  .about-teaser { display: grid; gap: var(--space-5); align-items: center; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .about-teaser img { border-radius: var(--radius-sm); max-height: 32rem; object-fit: cover; }
</style>

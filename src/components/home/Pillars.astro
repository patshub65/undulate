---
import { getPillars, getSettings, projectsUrl } from '../../lib/content';
const pillars = await getPillars();
const { pillars: intros } = await getSettings();
---
<section class="pillars" id="services" aria-labelledby="services-heading">
  <h2 id="services-heading" class="visually-hidden">Services</h2>
  {pillars.map((pillar) => (
    <article class={`pillar pillar--${pillar.id} cell`}>
      <p class="label">{pillar.specialties.length} specialties</p>
      <h3><a href={projectsUrl({ pillar: pillar.id })} data-track="Pillar Click" data-track-label={pillar.name}>{pillar.name}</a></h3>
      {intros[pillar.id] && <p class="pillar__intro">{intros[pillar.id]}</p>}
      <ul class="pillar__list">
        {pillar.specialties.map((s) => (
          <li>
            <a href={projectsUrl({ specialty: s.id })} data-track="Specialty Click" data-track-label={s.data.name}>{s.data.name}</a>
            {s.data.description && <span>{s.data.description}</span>}
          </li>
        ))}
      </ul>
    </article>
  ))}
</section>
<style>
  /* Kept from round 1: the two pillars as full colour fields, specialties under hairline rules. */
  .pillars { display: grid; }
  .pillar { padding-block: var(--space-6); }
  .pillar--production { background: var(--palette-yellow); }
  .pillar--curation { background: var(--palette-violet); color: #fff; }
  .pillar h3 { font-size: var(--d-lg); margin: var(--space-3) 0 var(--space-4); }
  .pillar h3 a { text-decoration: none; }
  .pillar h3 a:hover { text-decoration: underline; text-decoration-thickness: 0.08em; }
  .pillar__intro { font-size: 1.25rem; line-height: 2rem; max-width: 30rem; margin-bottom: var(--space-5); }
  .pillar__list { display: grid; gap: 0 var(--space-5); }
  .pillar__list li { display: grid; align-content: start; gap: var(--space-2); padding-block: var(--space-3) var(--space-4); border-top: 1px solid currentColor; }
  .pillar__list a { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; line-height: 1.5rem; text-decoration: none; justify-self: start; }
  .pillar__list a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  @media (min-width: 60rem) {
    .pillars { grid-template-columns: 7fr 5fr; align-items: start; padding-bottom: var(--space-6); }
    .pillar { padding-block: var(--space-7) var(--space-6); }
    .pillar--production { padding-left: var(--gutter); padding-right: var(--space-6); }
    .pillar--production .pillar__list { grid-template-columns: 1fr 1fr; }
    /* The violet field hangs lower than the yellow one. */
    .pillar--curation { padding-left: var(--space-6); padding-right: var(--gutter); margin-top: var(--space-7); margin-bottom: calc(-1 * var(--space-6)); min-height: 100%; }
  }
</style>

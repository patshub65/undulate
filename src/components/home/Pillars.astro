---
import { getPillars, getSettings, projectsUrl } from '../../lib/content';
const pillars = await getPillars();
const { pillars: intros } = await getSettings();
---
<section class="section container" id="services" aria-labelledby="services-heading">
  <h2 id="services-heading" class="visually-hidden">Services</h2>
  <div class="pillars">
    {pillars.map((pillar) => (
      <article class={`pillar pillar--${pillar.id}`}>
        <h3 class="pillar__name"><a href={projectsUrl({ pillar: pillar.id })} data-track="Pillar Click" data-track-label={pillar.name}>{pillar.name}</a></h3>
        {intros[pillar.id] && <p class="pillar__intro">{intros[pillar.id]}</p>}
        <ul class="pillar__specialties" role="list">
          {pillar.specialties.map((s) => (
            <li>
              <a href={projectsUrl({ specialty: s.id })} data-track="Specialty Click" data-track-label={s.data.name}>{s.data.name}</a>
              {s.data.description && <span class="muted">{s.data.description}</span>}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

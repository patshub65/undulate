---
/**
 * A single event: a button that opens a native popover with the details.
 * The flyer is never cropped. The homepage strip restyles the same markup (see UpcomingStrip).
 */
import { Image } from 'astro:assets';
import { formatDate, isoDate, type EventItem } from '../lib/content';

interface Props {
  event: Omit<EventItem, 'project'> & { project?: EventItem['project'] };
  id: string;
  showProject?: boolean;
  upcomingOnly?: boolean;
}
const { event, id, showProject = false, upcomingOnly = false } = Astro.props;
const popoverId = `event-${id}`;
---
<article class="ev" data-event-date={upcomingOnly ? isoDate(event.date) : undefined} style={event.project?.accent ? `--project-accent: ${event.project.accent}` : undefined}>
  <button class="ev__trigger" popovertarget={popoverId} data-track="Event Open" data-track-label={event.name}>
    {event.flyer ? (
      <Image class="ev__flyer" src={event.flyer} alt={`Flyer: ${event.name}`} widths={[320, 540, 800]} sizes="(min-width: 60rem) 28vw, 70vw" />
    ) : (
      <span class="ev__flyer ev__noflyer field"></span>
    )}
    <span class="ev__meta">
      <time class="date" datetime={isoDate(event.date)}>{formatDate(event.date)}</time>
      <span class="ev__name">{event.name}</span>
      {(event.venue || (showProject && event.project)) && <span class="ev__where">{[event.venue, showProject && event.project?.title].filter(Boolean).join(' · ')}</span>}
    </span>
  </button>

  <div id={popoverId} popover class="ev-pop">
    <button class="ev-pop__close" popovertarget={popoverId} popovertargetaction="hide">Close</button>
    <p class="date"><time datetime={isoDate(event.date)}>{formatDate(event.date)}</time>{event.venue && ` · ${event.venue}`}</p>
    <h3>{event.name}</h3>
    {event.details && <p class="ev-pop__details">{event.details}</p>}
    {showProject && event.project && (
      <p><a href={`/projects/${event.project.id}/`}>More from {event.project.title}</a></p>
    )}
    {event.link && (
      <a class="button" href={event.link} rel="noopener" target="_blank" data-track="Event Link" data-track-label={event.name}>Tickets & info</a>
    )}
  </div>
</article>

<style>
  .ev__trigger { all: unset; box-sizing: border-box; cursor: pointer; display: block; width: 100%; }
  .ev__trigger:focus-visible { outline: 2px solid var(--palette-violet); outline-offset: 4px; }
  .ev__flyer { display: block; width: 100%; height: auto; }
  .ev__noflyer { aspect-ratio: 4 / 5; background: radial-gradient(80% 80% at 50% 40%, color-mix(in oklab, var(--project-accent, #b893ff) 70%, var(--color-bg)), color-mix(in oklab, var(--project-accent, #b893ff) 20%, var(--color-bg))); }
  .ev__meta { display: grid; padding-top: var(--space-3); }
  .ev__name { font-family: var(--font-display); font-size: 1.5rem; line-height: 2rem; letter-spacing: var(--track-d); transition: color 500ms var(--ease-paper); }
  .ev__trigger:hover .ev__name { color: var(--palette-violet); transition-duration: 120ms; }
  .ev__where { color: var(--color-text-muted); }

  .ev-pop { width: min(30rem, 100% - 2 * var(--gutter)); padding: var(--space-5); border: 0; border-radius: 0; background: var(--color-bg); color: var(--color-text); }
  .ev-pop::backdrop { background: rgb(76 51 242 / 0.55); }
  .ev-pop h3 { font-size: 2rem; line-height: 2.5rem; margin: var(--space-2) 0 var(--space-3); }
  .ev-pop__close { all: unset; cursor: pointer; float: right; font-family: var(--font-label); font-weight: 500; text-decoration: underline; }
  .ev-pop__details { white-space: pre-line; }
</style>

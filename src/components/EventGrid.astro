---
import EventCard from './EventCard.astro';
import type { Project } from '../lib/content';

interface Props { project: Project }
const { project } = Astro.props;
const events = [...project.data.events].sort((a, b) => b.date.getTime() - a.date.getTime());
---
{events.length > 0 && (
  <ul class="event-grid">
    {events.map((event, i) => (
      <li><EventCard event={event} id={`${project.id}-${i}`} /></li>
    ))}
  </ul>
)}
<style>
  /* A flyer wall: cells share lines; an unfilled row end stays empty. */
  .event-grid { display: grid; }
  .event-grid li + li { border-top: var(--line); }
  @media (min-width: 60rem) {
    .event-grid { grid-template-columns: repeat(3, 1fr); }
    .event-grid li { border-right: var(--line); }
    .event-grid li + li { border-top: 0; }
    .event-grid li:nth-child(n + 4) { border-top: var(--line); }
    .event-grid li:nth-child(3n + 1) :global(.ev__meta), .event-grid li:nth-child(3n + 1) :global(.ev__stamp) { padding-left: var(--gutter); }
  }
</style>

---
import EventCard from './EventCard.astro';
import YearStrip from './YearStrip.astro';
import type { Project } from '../lib/content';

interface Props { project: Project }
const { project } = Astro.props;
const events = [...project.data.events]
  .map((event, i) => ({ event, i }))
  .sort((a, b) => b.event.date.getTime() - a.event.date.getTime());
const years = [...new Set(events.map(({ event }) => event.date.getFullYear()))];
---
{years.map((year) => (
  <YearStrip year={year}>
    {events.filter(({ event }) => event.date.getFullYear() === year).map(({ event, i }) => (
      <li><EventCard event={event} id={`${project.id}-${i}`} /></li>
    ))}
  </YearStrip>
))}

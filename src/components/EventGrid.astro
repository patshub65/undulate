---
import EventCard from './EventCard.astro';
import type { Project } from '../lib/content';

interface Props { project: Project }
const { project } = Astro.props;
const events = [...project.data.events].sort((a, b) => b.date.getTime() - a.date.getTime());
---
{events.length > 0 && (
  <ul class="event-grid">
    {events.map((event, i) => (
      <li><EventCard event={event} id={`${project.id}-${i}`} /></li>
    ))}
  </ul>
)}
<style>
  .event-grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); align-items: start; }
  @media (min-width: 60rem) {
    .event-grid { grid-template-columns: repeat(auto-fill, minmax(18rem, 22rem)); gap: var(--space-6); }
    .event-grid li:nth-child(3n + 2) { margin-top: var(--space-6); }
    .event-grid li:nth-child(3n + 3) { margin-top: var(--space-4); }
  }
</style>

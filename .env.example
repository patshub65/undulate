# Public URL of the site (used for canonical URLs and the sitemap).
SITE_URL=https://undulate.example

# Plausible analytics. Leave empty to disable the script entirely.
PUBLIC_PLAUSIBLE_DOMAIN=

# Keystatic: in `npm run dev` it edits files on disk; in production builds
# it commits to GitHub (repo set in keystatic.config.ts). These four values
# come from the Keystatic GitHub-app setup flow (see README):
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
